{
  "name": "pieshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first order and fulfilment platform for small merchants.",
  "engines": {
    "node": ">=22.18.0 <25",
    "npm": ">=10.9.3 <12"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security:audit": "npm audit --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "test:supabase:connection": "node --env-file=.env.local scripts/check-supabase-connection.mjs",
    "test:supabase:schema": "node --env-file=.env.local scripts/check-foundation-schema.mjs",
    "test:supabase:security": "node --env-file=.env.local scripts/test-foundation-security.mjs",
    "test:supabase:hardening": "node --env-file=.env.local scripts/check-foundation-hardening.mjs",
    "test:supabase:seed": "node --env-file=.env.local scripts/check-development-seed.mjs",
    "db:push:dry-run": "node --env-file=.env.local --experimental-strip-types scripts/push-supabase-migrations.ts --dry-run",
    "db:push:apply": "node --env-file=.env.local --experimental-strip-types scripts/push-supabase-migrations.ts --apply",
    "db:seed:apply": "node --env-file=.env.local --experimental-strip-types scripts/push-supabase-migrations.ts --seed",
    "db:reset:development": "node --env-file=.env.local --experimental-strip-types scripts/push-supabase-migrations.ts --reset",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run security:secrets && npm run security:audit"
  },
  "dependencies": {
    "@sentry/nextjs": "10.71.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "postgres": "3.4.9",
    "supabase": "^2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
